{
  "name": "dsh-opencode-go-plus",
  "version": "0.4.3",
  "description": "OpenCode Go model provider for DeepSeek Harness — a maintained fork that keeps the live model catalog reachable when another adapter already owns the opencode-go route, no longer drops models belonging to families the catalog has not seen before, configures itself from the Settings → Models page instead of a settings section of its own, and runs unchanged across the dsh 0.1.6 and 0.1.7 release trains, including their prereleases",
  "type": "module",
  "license": "MIT",
  "author": "HaydenSmith1121",
  "contributors": [
    "Duskriver (upstream dsh-opencode-go)",
    "DeepSeek Harness (adapter and conversion modules)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaydenSmith1121/dsh-opencode-go-plus.git"
  },
  "homepage": "https://github.com/HaydenSmith1121/dsh-opencode-go-plus#readme",
  "bugs": {
    "url": "https://github.com/HaydenSmith1121/dsh-opencode-go-plus/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "shipsPrebuilt": "This package distributes the compiled lib/ only; its sources are not part of the tarball, so there is no build step to run. See docs/derivation.md.",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-api-settings-controller": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-store": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-fs": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-timeout": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0",
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.1.7-alpha.0 <0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-settings-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-registry": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "opencode",
    "opencode-go",
    "llm",
    "cordis"
  ]
}
